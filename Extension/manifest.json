{
  "manifest_version": 3,
  "name": "Chunks Bridge",
  "version": "1.0.0",
  "description": "Lets the Chunks macOS companion read and act on the open web page, locally, with a confirm card for every click and keystroke.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}